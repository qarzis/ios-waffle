+++ b/Silicon/Silicium/SiliciumPkg/Library/BootManagerLib/XnuLoader.c
@@ -0,0 +1,26 @@
+/** HakiOS waffle adapter: invoke the verified RAM/USB loader from FV.
+ * No fixed payload address and no partition writes.
+ * SPDX-License-Identifier: BSD-2-Clause-Patent
+ */
+#include <Uefi.h>
+#include <Pi/PiFirmwareFile.h>
+#include <Library/DxeServicesLib.h>
+#include <Library/MemoryAllocationLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include <Library/DebugLib.h>
+#include "XnuLoader.h"
+VOID XnuLoaderMain (VOID)
+{
+  EFI_GUID Guid = {0x8148efc2,0xc15b,0x4518,{0x94,0x78,0xc9,0x8f,0x6d,0x3c,0x72,0x15}};
+  VOID *Buffer = NULL;
+  UINTN Size = 0;
+  EFI_HANDLE Image = NULL;
+  EFI_STATUS Status = GetSectionFromAnyFv (&Guid, EFI_SECTION_PE32, 0, &Buffer, &Size);
+  if (EFI_ERROR (Status)) { DEBUG ((DEBUG_ERROR,"waffle RAM loader missing: %r\n",Status)); return; }
+  Status = gBS->LoadImage (FALSE, gImageHandle, NULL, Buffer, Size, &Image);
+  FreePool (Buffer);
+  if (EFI_ERROR (Status)) { DEBUG ((DEBUG_ERROR,"waffle LoadImage: %r\n",Status)); return; }
+  Status = gBS->StartImage (Image, NULL, NULL);
+  DEBUG ((DEBUG_INFO,"waffle RAM loader returned: %r\n",Status));
+  gBS->UnloadImage (Image);
+}

CoreData: annotation:   Execute DA trigger creation statement: NSSQLiteStatement <0x14b08bbc0> on entity 'Asset' with sql text 'CREATE TRIGGER IF NOT EXISTS Z_DA_ZASSET_Asset_derivedCameraCaptureDevice_SOURCE_INSERT AFTER INSERT ON ZASSET FOR EACH ROW BEGIN UPDATE ZASSET SET ZDERIVEDCAMERACAPTUREDEVICE = (SELECT ZCAMERACAPTUREDEVICE FROM ZADDITIONALASSETATTRIBUTES WHERE Z_PK = NEW.ZADDITIONALATTRIBUTES) WHERE Z_PK = NEW.Z_PK; SELECT NSCoreDataDATriggerInsertUpdatedAffectedObjectValue('ZASSET', Z_ENT, Z_PK, 'derivedCameraCaptureDevice', ZDERIVEDCAMERACAPTUREDEVICE) FROM ZASSET WHERE Z_PK = NEW.Z_PK; END'
